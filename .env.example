# Telegram Bot token — get from @BotFather in Telegram
TELEGRAM_BOT_TOKEN=

# Comma-separated list of PUBLIC channel usernames (no @ needed) to scrape
# e.g. channelone,channeltwo,bitcoinsignals
TELEGRAM_CHANNELS=

# How many messages to fetch per channel per run (max 100 per request)
MESSAGES_LIMIT=100

# Anthropic API key — for summarization and signal extraction (step 2)
ANTHROPIC_API_KEY=
