# Telegram Bot token — get from @BotFather in Telegram
TELEGRAM_BOT_TOKEN=

# Comma-separated list of PUBLIC channel usernames (no @ needed) to scrape
# e.g. channelone,channeltwo,bitcoinsignals
TELEGRAM_CHANNELS=

# How many messages to fetch per channel per run (max 100 per request)
MESSAGES_LIMIT=100
# Scraper fetches up to MESSAGES_LIMIT posts per channel, then filters to last 24 hours

# Anthropic API key — for summarization and signal extraction (step 2)
ANTHROPIC_API_KEY=

# OpenRouter (optional) — if set, all LLM calls use OpenRouter instead of
# Anthropic. Get a key at https://openrouter.ai/keys. Models ending in :free
# cost $0 (limits: 20 requests/min, 50/day — or 1000/day after a one-time
# $10 credit purchase).
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Signal extraction (run_signals.py) always uses OPENROUTER_MODEL above when
# OpenRouter is active — defaults to the free Llama model.
#
# Brief generation (run_brief.py) uses this separate override instead, since
# brief-writing quality benefits from a stronger model. Defaults to paid
# Claude Sonnet via OpenRouter (billed to your OpenRouter balance, not
# OPENROUTER_MODEL's free tier).
# OPENROUTER_MODEL_BRIEF=anthropic/claude-sonnet-4.5
